{
  "name": "prompt-operations-hack",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "data:refresh": "python3 pipeline/refresh_catalog.py",
    "data:financials": "python3 pipeline/fetch_efficiency.py",
    "data:build": "python3 pipeline/fetch_efficiency.py --offline",
    "test:game": "tsc -p tests/tsconfig.json && node --require /tmp/tehokas-game-tests/tests/resolve-alias.cjs --test /tmp/tehokas-game-tests/tests/*.test.js",
    "test:outreach": "tsc -p tests/tsconfig.json && node --require /tmp/tehokas-game-tests/tests/resolve-alias.cjs --test /tmp/tehokas-game-tests/tests/outreach.test.js",
    "test:data": "python3 -m unittest discover -s pipeline -p 'test_*.py'",
    "data:sample": "python3 pipeline/fetch_efficiency.py --refresh-jobs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@dimforge/rapier3d-compat": "^0.21.0",
    "next": "^16.4.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
