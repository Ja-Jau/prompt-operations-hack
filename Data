def calculate_ai_efficiency_score(row):
    """
    Calculates the AI consulting potential based on financial structure (saved to CSV).
    """
    score = 50  
    
    rev_emp = row.get("Revenue/Employee") or 0
    if rev_emp > 1_000_000: score += 15
    elif rev_emp > 300_000: score += 10
    
    gap = row.get("Margin Gap (%)") or 0
    if gap > 25: score += 15
    elif gap > 15: score += 10

    emp = row.get("Employees") or 0
    if emp > 5_000: score += 10
    elif emp > 1_000: score += 5

    prof_margin = row.get("Profit Margin (%)")
    if prof_margin is not None:
        if prof_margin < 5: score += 10
        elif prof_margin < 10: score += 5

    return min(100, max(0, score))


def fetch_comprehensive_data(extra_tickers=None):
    """Fetches all financial key metrics for the companies and filters out non-working ones."""
    base_tickers = get_all_finnish_tickers()
    tickers = []
    
    # Prioritize user input by adding it to the front of the list
    if extra_tickers:
        for t in extra_tickers:
            # Using upper() ensures case-insensitivity in the matching list
            t_upper = t.upper()
            if t_upper not in tickers:
                tickers.append(t_upper)
                
    # Add the remaining base tickers
    for t in base_tickers:
        t_upper = t.upper()
        if t_upper not in tickers:
            tickers.append(t_upper)
            
    company_data = []
    non_working_companies = []
    total = len(tickers)
    
    print(f"\nFetching comprehensive financial data for {total} companies via Yahoo Finance...\n")

    for index, symbol in enumerate(tickers, start=1):
        try:
            ticker = yf.Ticker(symbol)
            info = ticker.info
            
            if not info or ('shortName' not in info and 'longName' not in info and 'totalRevenue' not in info):
                raise ValueError("Missing all basic info")
                
            name = info.get("shortName") or info.get("longName") or symbol
            employees = info.get("fullTimeEmployees")
            revenue = info.get("totalRevenue")
            net_income = info.get("netIncomeToCommon")
            
            if pd.isna(revenue) and pd.isna(employees):
                non_working_companies.append(name)
                print(f"[{index}/{total}] Skipping {name} ({symbol}) - Missing data")
                continue
            
            rev_per_emp = None
            net_income_per_emp = None
            
            if pd.notnull(revenue) and pd.notnull(employees) and employees > 0:
                rev_per_emp = revenue / employees
            
            if pd.notnull(net_income) and pd.notnull(employees) and employees > 0:
                net_income_per_emp = net_income / employees
                
            gross_margins = info.get("grossMargins")
            operating_margins = info.get("operatingMargins")
            profit_margins = info.get("profitMargins")
            
            gross_margin_pct = (gross_margins * 100) if pd.notnull(gross_margins) else None
            op_margin_pct = (operating_margins * 100) if pd.notnull(operating_margins) else None
            profit_margin_pct = (profit_margins * 100) if pd.notnull(profit_margins) else None
            
            margin_gap = (gross_margin_pct - op_margin_pct) if (pd.notnull(gross_margin_pct) and pd.notnull(op_margin_pct)) else None
            revenue_growth = info.get("revenueGrowth")
            dividend_yield = info.get("dividendYield")

            row = {
                "Symbol": symbol,
                "Company": name,
                "Sector": info.get("sector", "Unknown"),
                "Employees": employees,
                "Revenue (EUR)": revenue,
                "Net Income (EUR)": net_income,
                "Market Cap (EUR)": info.get("marketCap"),
                
                "Revenue/Employee": rev_per_emp,
                "Net Income/Employee": net_income_per_emp,
                "Margin Gap (%)": margin_gap,
                
                "Gross Margin (%)": gross_margin_pct,
                "Operating Margin (%)": op_margin_pct,
                "Profit Margin (%)": profit_margin_pct,
                "Revenue Growth (%)": (revenue_growth * 100) if pd.notnull(revenue_growth) else None,
                
                "P/E Ratio": info.get("trailingPE"),
                "P/S Ratio": info.get("priceToSalesTrailing12Months"),
                "Debt to Equity (%)": info.get("debtToEquity"),
                "Dividend Yield (%)": (dividend_yield * 100) if pd.notnull(dividend_yield) else None
            }
            
            row["AI Efficiency Score (0-100)"] = calculate_ai_efficiency_score(row)
            company_data.append(row)
            print(f"[{index}/{total}] Fetched data for: {name}")

        except Exception as e:
            print(f"[{index}/{total}] Missing (404/Error) - adding to non_working_companies: {symbol}")
            non_working_companies.append(symbol)

    return pd.DataFrame(company_data), non_working_companies


if __name__ == "__main__":
    print("="*95)
    print(" FINANCIAL DATA MATCHER & AI POTENTIAL CALCULATOR")
    print("="*95)
    
    # Allow the user to input a custom ticker (case-insensitive handling via .upper())
    user_input = input("Enter a custom ticker to add to the list (e.g., 'MSFT', 'KONE.HE') or press Enter to skip: ").strip().upper()
    
    custom_tickers = []
    if user_input:
        custom_tickers.append(user_input)
        print(f"-> Added '{user_input}' to the fetching queue.")
        
    df, non_working_companies = fetch_comprehensive_data(extra_tickers=custom_tickers)
    
    if not df.empty:
        # Sort by Revenue/Employee normally
        df = df.sort_values(by="Revenue/Employee", ascending=False, na_position='last')
        
        # Initialize an empty DataFrame for df_user with the same columns as df
        df_user = pd.DataFrame(columns=df.columns)
        
        # Extract the user's custom input to df_user and prioritize it at the top of df
        # We use .str.upper() on the dataframe symbols to ensure complete case-insensitivity
        if user_input and user_input in df['Symbol'].str.upper().values:
            df_user = df[df['Symbol'].str.upper() == user_input].copy()
            other_rows = df[df['Symbol'].str.upper() != user_input]
            df = pd.concat([df_user, other_rows])
            
        df = df.reset_index(drop=True)
        df_user = df_user.reset_index(drop=True)
        
        filename = "finnish_companies_all_metrics.csv"
        df.to_csv(filename, index=False, encoding="utf-8-sig")
        
