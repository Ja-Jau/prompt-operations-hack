def calculate_ai_efficiency_score(row):
    """
    Beräknar AI-konsultpotentialen utifrån finansiell struktur (sparas i CSV).
    """
    score = 50  
    
    rev_emp = row.get("Omsättning/Anställd") or 0
    if rev_emp > 1_000_000: score += 15
    elif rev_emp > 300_000: score += 10
    
    gap = row.get("Marginalgap (%)") or 0
    if gap > 25: score += 15
    elif gap > 15: score += 10

    emp = row.get("Anställda") or 0
    if emp > 5_000: score += 10
    elif emp > 1_000: score += 5

    prof_margin = row.get("Vinstmarginal (%)")
    if prof_margin is not None:
        if prof_margin < 5: score += 10
        elif prof_margin < 10: score += 5

    return min(100, max(0, score))


def fetch_comprehensive_data():
    """Hämtar alla finansiella nyckeltal för bolagen och filtrerar bort ickefungerande."""
    tickers = get_all_finnish_tickers()
    company_data = []
    ickefungerande_foretag = []
    total = len(tickers)
    
    print(f"Hämtar komplett finansiell data för {total} företag via Yahoo Finance...\n")

    for index, symbol in enumerate(tickers, start=1):
        try:
            ticker = yf.Ticker(symbol)
            info = ticker.info
            
            # Kolla om info är tomt (vissa avnoterade/felaktiga tickers returnerar tom dict)
            if not info or ('shortName' not in info and 'longName' not in info and 'totalRevenue' not in info):
                raise ValueError("Saknar all grundläggande info")
                
            name = info.get("shortName") or info.get("longName") or symbol
            employees = info.get("fullTimeEmployees")
            revenue = info.get("totalRevenue")
            net_income = info.get("netIncomeToCommon")
            
            # Om vi varken får omsättning eller anställda skippar vi företaget
            if pd.isna(revenue) and pd.isna(employees):
                ickefungerande_foretag.append(name)
                print(f"[{index}/{total}] Hoppar över {name} ({symbol}) - Saknar data")
                continue
            
            # Sätt till None som standard om någon av dem saknas
            rev_per_emp = None
            net_income_per_emp = None
            
            if pd.notnull(revenue) and pd.notnull(employees) and employees > 0:
                rev_per_emp = revenue / employees
            
            if pd.notnull(net_income) and pd.notnull(employees) and employees > 0:
                net_income_per_emp = net_income / employees
                
            gross_margins = info.get("grossMargins")
            operating_margins = info.get("operatingMargins")
            profit_margins = info.get("profitMargins")
            
            gross_margin_pct = (gross_margins * 100) if pd.notnull(gross_margins) else None
            op_margin_pct = (operating_margins * 100) if pd.notnull(operating_margins) else None
            profit_margin_pct = (profit_margins * 100) if pd.notnull(profit_margins) else None
            
            margin_gap = (gross_margin_pct - op_margin_pct) if (pd.notnull(gross_margin_pct) and pd.notnull(op_margin_pct)) else None
            revenue_growth = info.get("revenueGrowth")
            dividend_yield = info.get("dividendYield")

            row = {
                "Symbol": symbol,
                "Företag": name,
                "Sektor": info.get("sector", "Okänd"),
                "Anställda": employees,
                "Omsättning (EUR)": revenue,
                "Vinst (EUR)": net_income,
                "Börsvärde (EUR)": info.get("marketCap"),
                
                "Omsättning/Anställd": rev_per_emp,
                "Vinst/Anställd": net_income_per_emp,
                "Marginalgap (%)": margin_gap,
                
                "Bruttomarginal (%)": gross_margin_pct,
                "Rörelsemarginal (%)": op_margin_pct,
                "Vinstmarginal (%)": profit_margin_pct,
                "Omsättningstillväxt (%)": (revenue_growth * 100) if pd.notnull(revenue_growth) else None,
                
                "P/E-tal": info.get("trailingPE"),
                "P/S-tal": info.get("priceToSalesTrailing12Months"),
                "Skuldsättningsgrad (%)": info.get("debtToEquity"),
                "Direktavkastning (%)": (dividend_yield * 100) if pd.notnull(dividend_yield) else None
            }
            
            row["AI Efficiency Score (0-100)"] = calculate_ai_efficiency_score(row)
            company_data.append(row)
            print(f"[{index}/{total}] Hämtat data för: {name}")

        except Exception as e:
            # Fångar upp 404 och andra hämtningsfel och sparar i den skilda listan
            print(f"[{index}/{total}] Saknas (404/Error) - lägger till i ickefungerande_foretag: {symbol}")
            ickefungerande_foretag.append(symbol)

    return pd.DataFrame(company_data), ickefungerande_foretag


