import pandas as pd
import yfinance as yf

def get_finnish_tickers():
    """Täckande lista över finska börsbolag på Nasdaq Helsinki (.HE)."""
    return [
        "NESTE.HE", "NOKIA.HE", "FORTUM.HE", "KESKOA.HE", "KNEBV.HE", "UPM.HE", "STERV.HE", 
        "WRT1V.HE", "METSA.HE", "VALMT.HE", "OUT1V.HE", "CGCBV.HE", "ELISA.HE", "ORNBV.HE", 
        "HUH1V.HE", "TYRES.HE", "FSKRS.HE", "KEMIRA.HE", "TIETO.HE", "YIT.HE", "KCR.HE", 
        "MEO1V.HE", "QTCOM.HE", "REMEDY.HE", "HARVIA.HE", "MUSTI.HE", "KROS.HE", "TLT1V.HE", 
        "TAL1V.HE", "TOKMAN.HE", "PON1V.HE", "KAMUX.HE", "VERK.HE", "NOHO.HE", "PIZZ.HE", 
        "PUUILO.HE", "STCBV.HE", "SANOMA.HE", "AKTIA.HE", "OHO1V.HE", "CITY1S.HE", "OLVAS.HE", 
        "SSABBH.HE", "NEXI.HE", "ALBBV.HE", "BITTI.HE", "AAPNT.HE", "ENERS.HE", "DIGIA.HE", 
        "INDER.HE", "FCA1V.HE", "HONBS.HE", "LASS88.HE", "MARAS.HE", "RAUTE.HE", "SRV1V.HE", 
        "SSH1V.HE", "TEL11V.HE", "UNR1V.HE", "VAIAS.HE", "VIK1V.HE", "WSC1V.HE"
    ]

def fetch_advanced_company_data():
    """Hämtar djupgående nyckeltal för alla finska börsbolag."""
    tickers = get_finnish_tickers()
    company_data = []
    total = len(tickers)
    
    print(f"Hämtar avancerad företagsdata för {total} finska bolag via Yahoo Finance...\n")

    for index, symbol in enumerate(tickers, start=1):
        try:
            ticker = yf.Ticker(symbol)
            info = ticker.info
            
            name = info.get("shortName") or info.get("longName") or symbol
            employees = info.get("fullTimeEmployees")
            revenue = info.get("totalRevenue")
            net_income = info.get("netIncomeToCommon")
            
            # Vi kräver både omsättning och anställda för att kunna beräkna per-anställd-data
            if revenue and employees and employees > 0:
                rev_per_emp = revenue / employees
                net_income_per_emp = (net_income / employees) if net_income else None
                
                # Hämtar ytterligare kategorier
                market_cap = info.get("marketCap")
                profit_margin = info.get("profitMargins")
                operating_margin = info.get("operatingMargins")
                revenue_growth = info.get("revenueGrowth")
                pe_ratio = info.get("trailingPE")
                ps_ratio = info.get("priceToSalesTrailing12Months")
                debt_to_equity = info.get("debtToEquity")
                dividend_yield = info.get("dividendYield")
                sector = info.get("sector", "Okänd")

                company_data.append({
                    "Symbol": symbol,
                    "Företag": name,
                    "Sektor": sector,
                    "Anställda": employees,
                    "Omsättning (EUR)": revenue,
                    "Vinst (EUR)": net_income,
                    "Börsvärde (EUR)": market_cap,
                    
                    # Beräknade & Kvantifierade Nyckeltal
                    "Omsättning/Anställd": rev_per_emp,
                    "Vinst/Anställd": net_income_per_emp,
                    "Vinstmarginal (%)": (profit_margin * 100) if profit_margin else None,
                    "Rörelsemarginal (%)": (operating_margin * 100) if operating_margin else None,
                    "Omsättningstillväxt (%)": (revenue_growth * 100) if revenue_growth else None,
                    "P/E-tal": pe_ratio,
                    "P/S-tal": ps_ratio,
                    "Skuldsättningsgrad (%)": debt_to_equity,
                    "Direktavkastning (%)": (dividend_yield * 100) if dividend_yield else None
                })
                print(f"[{index}/{total}] Hämtat: {name}")
            else:
                print(f"[{index}/{total}] Hoppar över {symbol} (Saknar anställda/omsättning)")

        except Exception as e:
            print(f"[{index}/{total}] Fel vid hämtning av {symbol}: {e}")

    return pd.DataFrame(company_data)


# ==========================================
# HUVUDPROGRAM
# ==========================================
if __name__ == "__main__":
    df = fetch_advanced_company_data()
    
    if not df.empty:
        # Sortera primärt på Omsättning per Anställd
        df = df.sort_values(by="Omsättning/Anställd", ascending=False).reset_index(drop=True)
        
        # Spara hela datasetet med alla nyckeltal till CSV för Excel-analys
        filename = "finska_foretag_utokad_analys.csv"
        df.to_csv(filename, index=False, encoding="utf-8-sig")
        print(f"\n" + "="*80)
        print(f"KLART! {len(df)} företag hämtade med alla nyckeltal.")
        print(f"Hela datasetet har sparats till filen: '{filename}'")
        print("="*80 + "\n")
        
        # Visa topp 10 i konsolen med utvalda kategorier
        preview = df[["Företag", "Sektor", "Anställda", "Omsättning/Anställd", "Vinst/Anställd", "Vinstmarginal (%)", "P/E-tal"]].head(10).copy()
        
        preview["Omsättning/Anställd"] = preview["Omsättning/Anställd"].apply(lambda x: f"€{x:,.0f}" if pd.notnull(x) else "N/A")
        preview["Vinst/Anställd"] = preview["Vinst/Anställd"].apply(lambda x: f"€{x:,.0f}" if pd.notnull(x) else "N/A")
        preview["Vinstmarginal (%)"] = preview["Vinstmarginal (%)"].apply(lambda x: f"{x:.1f}%" if pd.notnull(x) else "N/A")
        
        pd.set_option('display.max_columns', 10)
        pd.set_option('display.width', 1000)
        print("FÖRHANDSGRANSKNING (TOPP 10 SORTERAT PÅ OMSÄTTNING/ANSTÄLLD):")
        print(preview.to_string(index=True))
    else:
        print("Ingen data kunde hämtas.")
